{
  "headers": [
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=31536000, immutable" } ] },
    { "source": "/data/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ],
  "rewrites": [
    { "source": "/img/:owner/:id/:file", "destination": "https://source.roboflow.com/:owner/:id/:file" }
  ]
}
